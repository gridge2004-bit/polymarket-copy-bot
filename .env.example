# Copy to .env and fill in. NEVER commit the real .env.

# ── Polymarket US credentials (required only when going live) ──
CLOB_API_KEY=
CLOB_SECRET=

# ── Copy-trading config ──
COPY_WALLET=0x9495425feeb0c250accb89275c97587011b19a27
SCALE_FACTOR=0.003
MAX_BET_USDC=1.0
MIN_BET_USDC=0.50
POLL_INTERVAL=5

# Keep this true until you've watched dry-run output for a while.
DRY_RUN=true

# ── Assistant layer (optional) ──
# Without this key the routines still run (deterministic digests only).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-6
